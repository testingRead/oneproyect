; OneProyect - graybox Android de bajo costo
; Godot 4.7.1 estable, GDScript y renderer Compatibility/OpenGL.

config_version=5

[application]

config/name="OneProyect"
run/main_scene="res://scenes/bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.webp"
boot_splash/bg_color=Color(0.055, 0.067, 0.082, 1)
boot_splash/image="res://assets/boot_splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
run/max_fps=60

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

buffering/agile_event_flushing=true

[input]

move_left={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194311)]
}
move_right={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194313)]
}
move_forward={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
jump={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
sprint={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
push={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
shoot={
"deadzone": 0.3,
"events": [Object(InputEventMouseButton,"button_index":1), Object(InputEventKey,"physical_keycode":70)]
}
reload={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
crouch={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":67), Object(InputEventKey,"physical_keycode":4194327)]
}
pause={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":80), Object(InputEventKey,"physical_keycode":4194305)]
}
restart={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=18.0

[network]

server_address="149.50.152.250"
server_port=9999

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
occlusion_culling/use_occlusion_culling=false
environment/defaults/default_clear_color=Color(0.055, 0.067, 0.082, 1)
